# Copy this file to .env for local-only configuration.
# Never place real credentials in .env.example.
SCRAPEX_HOST=127.0.0.1
SCRAPEX_PORT=8125
SCRAPEX_DATA_ROOT=X:\ScrapeX\data
SCRAPEX_CIQ_BASE_URL=http://127.0.0.1:8084/api/v1/tools/v1/calibration-iq
SCRAPEX_CIQ_PROJECT_PATH=X:\calibration iq
SCRAPEX_ADAS_MAP_HOME=https://opus.adasmap.com/login

# ADAS SI and ALLDATA automation are intentionally frozen/manual-future.

# Prefer a dedicated scoped service token. Leave this empty in the template.
SCRAPEX_CIQ_TOKEN=
